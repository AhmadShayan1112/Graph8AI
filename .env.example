# Server-side environment. Locally: copy to .env. On Vercel: Project → Settings → Environment Variables.
# The Claude token and Graph8 API key do NOT go here; enter them in the app's Settings page,
# where they are stored AES-256-GCM encrypted in MongoDB.

# MongoDB connection string (e.g. MongoDB Atlas)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Optional, defaults to "gapwise"
MONGODB_DB=gapwise

# Encryption key for stored secrets. Generate with: openssl rand -base64 48
# Changing or losing it makes saved secrets unreadable (just re-enter them in Settings).
GAPWISE_SECRET=

# Password for signing in to the app. Required on Vercel.
ADMIN_PASSWORD=

# Optional local-dev fallback if no Graph8 key is saved in Settings. Leave unset on Vercel.
# G8_API_KEY=
# G8_BASE_URL=https://be.graph8.com
